{
  "name": "life-mirror",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs",
    "anchors": "node scripts/anchors-md.mjs",
    "catalogue": "node scripts/catalogue-md.mjs",
    "library": "node scripts/library-check.mjs",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "worker:dev": "wrangler dev --config worker/wrangler.toml --test-scheduled"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "dexie": "^4.4.5",
    "preact": "^10.25.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@playwright/test": "^1.50.0",
    "@preact/preset-vite": "^2.9.0",
    "@types/node": "^22.10.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.6.0",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.1.0",
    "wrangler": "^4.135.0"
  }
}
